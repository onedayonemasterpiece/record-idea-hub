# Phone-to-backend authentication. Generate a unique random value, 32+ characters.
RECORD_IDEA_HUB_DEVICE_TOKEN=replace-with-random-device-token

# GitHub credential scoped to Contents: write for onedayonemasterpiece/idea-hub only.
IDEA_HUB_GITHUB_TOKEN=replace-with-fine-grained-token
IDEA_HUB_GITHUB_REPOSITORY=onedayonemasterpiece/idea-hub
IDEA_HUB_GITHUB_BRANCH=main

# The canonical online limiter used by events-bot-new.
GOOGLE_AI_LIMITER_SUPABASE_URL=https://replace.supabase.co
GOOGLE_AI_LIMITER_SUPABASE_SERVICE_KEY=replace-with-service-key
GOOGLE_AI_NORMAL_KEY_ENVS=GOOGLE_API_KEY
GOOGLE_API_KEY=replace-with-google-api-key

# Only a Gemini Flash-Lite model is accepted by the application.
GEMINI_LITE_MODEL=gemini-3.1-flash-lite

RECORD_IDEA_HUB_DATA_DIR=/data
RECORD_IDEA_HUB_PROCESSOR_ENABLED=1
GOOGLE_AI_ALLOW_RESERVE_FALLBACK=0
GOOGLE_AI_LOCAL_LIMITER_FALLBACK=0
GOOGLE_AI_LOCAL_LIMITER_ON_RESERVE_ERROR=0
